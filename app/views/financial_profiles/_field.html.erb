<%# One profile question, rendered by its type. Blank always means "not answered". %>
<% input_class = "w-full px-3 py-2 border border-gray-300 rounded-md" %>
<div class="<%= "md:col-span-2" if field.text? %>">
  <%= form.label field.name, field.label, class: "block text-sm font-medium text-gray-700 mb-1" %>
  <% case field.type %>
  <% when :money %>
    <div class="relative">
      <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">$</span>
      <%= form.number_field field.name, step: :any, min: 0, class: "#{input_class} pl-7 text-right" %>
    </div>
  <% when :percent %>
    <div class="relative">
      <%= form.number_field field.name, step: :any, min: 0, max: 100, class: "#{input_class} pr-8 text-right" %>
      <span class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500">%</span>
    </div>
  <% when :integer %>
    <%= form.number_field field.name, step: 1, min: 0, class: "#{input_class} text-right" %>
  <% when :select %>
    <%= form.select field.name, options_for_select(field.options.invert, profile.public_send(field.name)),
          { include_blank: "Not answered" }, class: "#{input_class} bg-white" %>
  <% when :boolean %>
    <%= form.select field.name, options_for_select([["Yes", "true"], ["No", "false"]], profile.public_send(field.name).to_s.presence),
          { include_blank: "Not answered" }, class: "#{input_class} bg-white" %>
  <% when :text %>
    <%= form.text_area field.name, rows: 3, class: input_class, placeholder: field.hint %>
  <% end %>
  <% if field.hint && !field.text? %>
    <p class="text-xs text-gray-500 mt-1"><%= field.hint %></p>
  <% end %>
</div>
