<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold mb-2">App info</h1>
  <p class="text-gray-600 mb-6">The build this instance is running. Also available as <%= link_to "JSON", app_info_path(format: :json), class: "text-blue-600 hover:underline" %>.</p>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <dl class="divide-y divide-gray-200">
      <% @details.each do |label, value| %>
        <div class="flex justify-between gap-4 px-6 py-3">
          <dt class="text-sm font-medium text-gray-500"><%= label %></dt>
          <dd class="text-sm text-gray-900 text-right font-mono"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
