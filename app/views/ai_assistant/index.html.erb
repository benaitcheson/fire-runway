<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">AI Assistant (Ollama)</h1>
  
  <div class="bg-white rounded-lg shadow-md p-6" data-controller="ai-chat">
    <form data-action="submit->ai-chat#submit" class="space-y-4">
      <div>
        <label for="prompt" class="block text-sm font-medium text-gray-700 mb-2">Ask a question:</label>
        <textarea data-ai-chat-target="prompt" id="prompt" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Enter your question here..."></textarea>
      </div>
      
      <div>
        <label for="model" class="block text-sm font-medium text-gray-700 mb-2">Select Model:</label>
        <select data-ai-chat-target="model" id="model" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
          <option value="llama3.2:latest">Llama 3.2</option>
          <option value="deepseek-r1:latest">DeepSeek R1</option>
          <option value="my-testing-model:latest">My Testing Model</option>
        </select>
      </div>
      
      <div>
        <button type="submit" data-ai-chat-target="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer">Send</button>
      </div>
    </form>
    
    <div class="mt-4 p-4 bg-blue-50 rounded-md hidden">
      <h3 class="font-semibold mb-2">Your Question:</h3>
      <div class="whitespace-pre-wrap" data-ai-chat-target="question"></div>
    </div>
    
    <div class="mt-6 p-4 bg-gray-100 rounded-md hidden">
      <h3 class="font-semibold mb-2">Response:</h3>
      <div class="whitespace-pre-wrap" data-ai-chat-target="response"></div>
    </div>
  </div>
  
  <div class="mt-8 bg-gray-50 rounded-lg p-6">
    <h2 class="text-xl font-semibold mb-4">Available Models</h2>
    <% if @models && @models['models'] %>
      <div class="grid gap-4">
        <% @models['models'].each do |model| %>
          <div class="bg-white p-4 rounded border border-gray-200">
            <h3 class="font-medium"><%= model['name'] %></h3>
            <p class="text-sm text-gray-600">Size: <%= number_to_human_size(model['size']) %></p>
            <p class="text-sm text-gray-600">Modified: <%= Time.parse(model['modified_at']).strftime("%B %d, %Y") %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-600">No models found. Make sure Ollama is running.</p>
    <% end %>
  </div>
</div>