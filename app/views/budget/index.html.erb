<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Cashflow Allocator</h1>
  </div>

  <% frequencies = BudgetItem::FREQUENCIES.keys %>

  <% @sections.each do |section, items| %>
    <div class="bg-white rounded-lg shadow-md overflow-x-auto mb-8">
      <table class="min-w-full">
        <thead class="bg-gray-100">
          <tr>
            <th class="py-3 px-4 text-left text-xs font-medium text-gray-700 uppercase tracking-wider w-64">
              <%= BudgetItem::SECTIONS[section] %>
            </th>
            <th class="py-3 px-4 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Amount</th>
            <th class="py-3 px-4 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">Frequency</th>
            <% frequencies.each do |freq| %>
              <th class="py-3 px-4 text-right text-xs font-medium text-gray-700 uppercase tracking-wider"><%= freq.capitalize %></th>
            <% end %>
            <th class="py-3 px-2"></th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-200">
          <% items.each do |item| %>
            <tr id="<%= dom_id(item) %>" class="hover:bg-gray-50 transition-colors <%= 'text-gray-400' if item.amount_cents.zero? %>">
              <td class="py-2 px-4 text-sm font-medium"><%= item.name %></td>
              <td class="py-2 px-4 text-right">
                <%= form_with model: item, url: budget_item_path(item), method: :patch, id: dom_id(item, :amount_form) do |f| %>
                  <%= f.number_field :amount, step: 0.01, min: 0,
                        id: dom_id(item, :amount),
                        onchange: "this.form.requestSubmit()",
                        class: "w-28 text-right text-sm border border-gray-200 rounded px-2 py-1" %>
                <% end %>
              </td>
              <td class="py-2 px-4 text-center">
                <%= form_with model: item, url: budget_item_path(item), method: :patch, id: dom_id(item, :frequency_form) do |f| %>
                  <%= f.select :frequency, BudgetItem::FREQUENCIES.keys,
                        {}, { id: dom_id(item, :frequency),
                              onchange: "this.form.requestSubmit()",
                              class: "text-sm border border-gray-200 rounded px-2 py-1" } %>
                <% end %>
              </td>
              <% frequencies.each do |freq| %>
                <td class="py-2 px-4 text-sm text-right tabular-nums">
                  <%= budget_amount(item.amount_per(freq)) %>
                </td>
              <% end %>
              <td class="py-2 px-2 text-center">
                <%= button_to "✕", budget_item_path(item), method: :delete,
                      data: { turbo_confirm: "Remove #{item.name}?" },
                      class: "text-gray-400 hover:text-red-600 text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>

        <tfoot class="bg-gray-100 font-bold">
          <tr>
            <td class="py-3 px-4 text-sm" colspan="3">Total <%= BudgetItem::SECTIONS[section] %></td>
            <% frequencies.each do |freq| %>
              <td class="py-3 px-4 text-sm text-right tabular-nums"><%= budget_amount(budget_total(items, freq)) %></td>
            <% end %>
            <td></td>
          </tr>
        </tfoot>
      </table>

      <div class="p-3 border-t border-gray-100">
        <%= form_with model: BudgetItem.new, url: budget_items_path, class: "flex items-center gap-2" do |f| %>
          <%= f.hidden_field :section, value: section, id: "add_#{section}_section" %>
          <%= f.text_field :name, placeholder: "Add a row…", required: true, id: "add_#{section}_name",
                class: "text-sm border border-gray-200 rounded px-2 py-1 w-64" %>
          <%= f.number_field :amount, step: 0.01, min: 0, placeholder: "0.00", id: "add_#{section}_amount",
                class: "text-sm border border-gray-200 rounded px-2 py-1 w-28 text-right" %>
          <%= f.select :frequency, BudgetItem::FREQUENCIES.keys, {},
                { id: "add_#{section}_frequency", class: "text-sm border border-gray-200 rounded px-2 py-1" } %>
          <%= f.submit "Add", class: "bg-blue-500 hover:bg-blue-700 text-white text-sm font-bold py-1 px-3 rounded cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% income = @sections["income"]; expenses = @sections["bills"] + @sections["everyday"] %>
  <div class="bg-white rounded-lg shadow-md overflow-x-auto">
    <table class="min-w-full">
      <thead class="bg-gray-800 text-white">
        <tr>
          <th class="py-3 px-4 text-left text-xs font-medium uppercase tracking-wider w-64" colspan="3">Surplus</th>
          <% frequencies.each do |freq| %>
            <th class="py-3 px-4 text-right text-xs font-medium uppercase tracking-wider"><%= freq.capitalize %></th>
          <% end %>
          <th class="py-3 px-2"></th>
        </tr>
      </thead>
      <tbody>
        <tr class="font-bold">
          <td class="py-3 px-4" colspan="3"></td>
          <% frequencies.each do |freq| %>
            <% surplus = budget_total(income, freq) - budget_total(expenses, freq) %>
            <td class="py-3 px-4 text-sm text-right tabular-nums <%= surplus.negative? ? 'text-red-600' : 'text-green-600' %>">
              <%= budget_amount(surplus) %>
            </td>
          <% end %>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
