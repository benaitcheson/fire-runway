<%= form_with(model: user_liability, local: true) do |form| %>
  <% if user_liability.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-6">
      <h3 class="text-red-800 font-semibold mb-2">
        <%= pluralize(user_liability.errors.count, "error") %> prohibited this liability from being saved:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% user_liability.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :item_name, "Liability Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :item_name, 
          class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-red-500 focus:border-red-500",
          placeholder: "e.g., Home Mortgage, Car Loan, Credit Card Debt" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :amount, "Amount Owed", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">$</span>
          <%= form.number_field :amount_cents, 
              value: user_liability.amount_cents ? (user_liability.amount_cents / 100.0) : nil,
              step: 0.01,
              min: 0,
              class: "w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-red-500 focus:border-red-500",
              placeholder: "0.00" %>
        </div>
        <p class="mt-1 text-xs text-gray-500">Enter the amount owed in dollars</p>
      </div>

      <div>
        <%= form.label :amount_currency, "Currency", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.select :amount_currency, 
            options_for_select([
              ["Australian Dollar (AUD)", "AUD"],
              ["US Dollar (USD)", "USD"],
              ["Euro (EUR)", "EUR"],
              ["British Pound (GBP)", "GBP"],
              ["Japanese Yen (JPY)", "JPY"]
            ], user_liability.amount_currency || "AUD"),
            {},
            class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-red-500 focus:border-red-500" %>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            Remember to regularly update your liabilities as you make payments to track your progress.
          </p>
        </div>
      </div>
    </div>

    <div class="flex justify-between pt-6 border-t">
      <%= link_to "Cancel", user_liabilities_path, class: "px-4 py-2 text-gray-700 hover:text-gray-900" %>
      <%= form.submit class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-6 rounded cursor-pointer" %>
    </div>
  </div>
<% end %>

<script>
  // Convert dollars to cents before submitting
  document.querySelector('form').addEventListener('submit', function(e) {
    const amountField = document.querySelector('#user_liability_amount_cents');
    if (amountField && amountField.value) {
      amountField.value = Math.round(parseFloat(amountField.value) * 100);
    }
  });
</script>