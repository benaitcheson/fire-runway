<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6 flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold"><%= @user_liability.item_name %></h1>
      <p class="text-gray-600 mt-2">Liability Details</p>
    </div>
    <div class="flex space-x-2">
      <%= link_to "Edit", edit_user_liability_path(@user_liability), 
          class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      <%= link_to "Delete", user_liability_path(@user_liability), 
          method: :delete,
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this liability?" },
          class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="p-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Amount Owed</h3>
          <p class="text-2xl font-bold text-red-600">
            <%= format_currency(@user_liability.amount_cents, @user_liability.amount_currency) %>
          </p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Currency</h3>
          <p class="text-xl font-semibold text-gray-900">
            <%= @user_liability.amount_currency %>
          </p>
        </div>
      </div>

      <div class="border-t pt-6">
        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Tracking Information</h3>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <dt class="text-sm text-gray-600">Date Added</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= @user_liability.created_at.strftime("%B %d, %Y") %>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-gray-600">Days Since Added</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= distance_of_time_in_words(@user_liability.created_at, Date.today) %> ago
            </dd>
          </div>
          <div>
            <dt class="text-sm text-gray-600">Added to System</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= @user_liability.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-gray-600">Last Updated</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= @user_liability.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
            </dd>
          </div>
        </dl>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700">
              <strong>Tip:</strong> Consider setting up automatic payments or reminders to help pay down this liability regularly.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-gray-50 px-6 py-4">
      <div class="flex justify-between items-center">
        <%= link_to "← Back to Liabilities", user_liabilities_path, 
            class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <%= link_to "Add Another Liability", new_user_liability_path, 
            class: "text-red-600 hover:text-red-800 font-medium" %>
      </div>
    </div>
  </div>
</div>