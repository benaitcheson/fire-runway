<div data-controller="slider-sync">
  <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label>
  <div class="flex items-center gap-3">
    <input
      type="range"
      min="<%= min %>"
      max="<%= max %>"
      step="<%= step %>"
      value="<%= value %>"
      class="flex-1 h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600"
      data-slider-sync-target="slider"
      data-action="input->slider-sync#syncToNumber"
    >
    <input
      type="number"
      name="<%= name %>"
      value="<%= value %>"
      min="<%= min %>"
      max="<%= max %>"
      step="<%= step %>"
      class="w-28 border border-gray-300 rounded px-2 py-1 text-sm text-right"
      data-slider-sync-target="number"
      data-action="input->slider-sync#syncToSlider"
    >
  </div>
</div>
