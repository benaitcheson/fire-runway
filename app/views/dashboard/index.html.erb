<p>Welcome, <%= current_user.email %></p>

<h1 class="text-2xl font-bold mb-4">Dashboard</h1>

<div class="mb-4">
  <h2 class="text-xl font-bold">Net Worth</h2>
  <%= line_chart @user_assets.size, xtitle: "Size", ytitle: "Population" %>
</div>

<div class="mb-4">
  <h2 class="text-xl font-bold">Assets</h2>
  <table class="min-w-full bg-white border border-gray-200">
    <thead>
      <tr>
        <th class="py-2 px-4 border-b">Item Name</th>
        <th class="py-2 px-4 border-b">Purchase Price (Cents)</th>
        <th class="py-2 px-4 border-b">Currency</th>
        <th class="py-2 px-4 border-b">Purchase Date</th>
      </tr>
    </thead>
    <tbody>
      <% @user_assets.each do |asset| %>
        <tr class="hover:bg-gray-100">
          <td class="py-2 px-4 border-b"><%= asset.item_name %></td>
          <td class="py-2 px-4 border-b"><%= asset.purchase_price_cents %></td>
          <td class="py-2 px-4 border-b"><%= asset.purchase_price_currency %></td>
          <td class="py-2 px-4 border-b"><%= asset.purchase_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mb-4">
  <h2 class="text-xl font-bold">Liabilities</h2>
  <table class="min-w-full bg-white border border-gray-200">
    <thead>
      <tr>
        <th class="py-2 px-4 border-b">Item Name</th>
        <th class="py-2 px-4 border-b">Amount (Cents)</th>
        <th class="py-2 px-4 border-b">Currency</th>
        <th class="py-2 px-4 border-b">Created At</th>
      </tr>
    </thead>
    <tbody>
      <% @user_liabilities.each do |liability| %>
        <tr class="hover:bg-gray-100">
          <td class="py-2 px-4 border-b"><%= liability.item_name %></td>
          <td class="py-2 px-4 border-b"><%= liability.amount_cents %></td>
          <td class="py-2 px-4 border-b"><%= liability.amount_currency %></td>
          <td class="py-2 px-4 border-b"><%= liability.created_at %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>