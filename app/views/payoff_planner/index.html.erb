<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-2">Payoff Planner</h1>
  <p class="text-gray-600 mb-6">Work out where your spare cash does the most damage to your debts.</p>

  <% if @liabilities.empty? %>
    <div class="bg-white rounded-lg shadow-md p-8 text-center">
      <p class="text-gray-500 mb-4">Add your debts first — include their interest rates so we can rank them.</p>
      <%= link_to "Add a liability", new_user_liability_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  <% else %>
    <%= form_with url: payoff_planner_path, method: :get, class: "bg-white rounded-lg shadow-md p-6 mb-6 flex flex-wrap items-end gap-4" do |form| %>
      <div>
        <%= form.label :monthly_budget, "Spare cash per month", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-500 mb-1">Defaults to your budget surplus</p>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">$</span>
          <%= form.number_field :monthly_budget, value: @monthly_budget, step: 10, min: 0,
                class: "w-40 pl-7 pr-3 py-2 border border-gray-300 rounded-md text-right" %>
        </div>
      </div>
      <div>
        <%= form.label :investment_return, "Expected investment return", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-500 mb-1">For the pay-down vs invest comparison</p>
        <div class="relative">
          <%= form.number_field :investment_return, value: @investment_return, step: 0.1, min: 0,
                class: "w-40 pr-8 pl-3 py-2 border border-gray-300 rounded-md text-right" %>
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500">%</span>
        </div>
      </div>
      <%= form.submit "Recalculate", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
    <% end %>

    <% if @avalanche.insufficient_budget %>
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-6 mb-6">
        <h2 class="font-bold text-lg mb-1">Your spare cash doesn't cover the interest</h2>
        <p>At <%= format_currency((@monthly_budget * 100).round, "AUD") %>/month your balances grow faster than you can pay them down.
        Increase the monthly amount, or check the interest rates on your liabilities.</p>
      </div>
    <% else %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
        <h2 class="font-bold text-lg text-green-900 mb-1">
          Pay off <%= @highest_rate_debt.item_name %> first
        </h2>
        <p class="text-green-900">
          At <%= @highest_rate_debt.interest_rate %>% it's your most expensive debt. Highest-rate-first (the
          "avalanche") clears everything in <%= @avalanche.months %> months
          (<%= @avalanche.debt_free_date.strftime("%B %Y") %>)<% if @interest_saved_cents.positive? %>
          and saves <%= format_currency(@interest_saved_cents, "AUD") %> in interest compared to
          paying smallest-balance-first<% end %>.
        </p>
        <% if @investment_return > @highest_rate_debt.interest_rate.to_f %>
          <p class="mt-2 text-green-900">
            Note: your expected investment return (<%= @investment_return %>%) beats your highest debt rate
            (<%= @highest_rate_debt.interest_rate %>%). Mathematically, investing your spare cash and paying
            just the minimums comes out ahead — guaranteed debt interest vs uncertain market returns is the trade-off.
          </p>
        <% else %>
          <p class="mt-2 text-green-900">
            Paying this debt is a guaranteed <%= @highest_rate_debt.interest_rate %>% return — better than your
            expected <%= @investment_return %>% from investing, and risk-free.
          </p>
        <% end %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <% { "Avalanche (highest rate first)" => @avalanche, "Snowball (smallest balance first)" => @snowball }.each do |title, result| %>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-gray-800 mb-3"><%= title %></h3>
            <dl class="space-y-1 text-sm mb-4">
              <div class="flex justify-between"><dt class="text-gray-500">Debt free</dt>
                <dd class="font-medium"><%= result.debt_free_date.strftime("%B %Y") %> (<%= result.months %> months)</dd></div>
              <div class="flex justify-between"><dt class="text-gray-500">Total interest paid</dt>
                <dd class="font-medium"><%= format_currency(result.total_interest_cents, "AUD") %></dd></div>
            </dl>
            <ol class="list-decimal list-inside text-sm text-gray-700 space-y-1">
              <% result.payoff_order.each do |payoff| %>
                <li><%= payoff[:name] %> <span class="text-gray-400">— month <%= payoff[:month] %></span></li>
              <% end %>
            </ol>
          </div>
        <% end %>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="font-semibold text-gray-800 mb-4">Total debt over time</h3>
        <%= line_chart [
              { name: "Avalanche", data: @avalanche.monthly_totals.transform_values { |c| (c / 100.0).round(2) } },
              { name: "Snowball", data: @snowball.monthly_totals.transform_values { |c| (c / 100.0).round(2) } }
            ],
            height: "300px", prefix: "$", thousands: ",",
            colors: ["#10b981", "#3b82f6"],
            xtitle: "Month", curve: false %>
      </div>
    <% end %>

    <div class="mt-6 bg-white rounded-lg shadow-md overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-gray-100">
          <tr>
            <th class="py-3 px-4 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Debt</th>
            <th class="py-3 px-4 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Balance</th>
            <th class="py-3 px-4 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Interest rate</th>
            <th class="py-3 px-4 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Minimum / month</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @liabilities.each do |liability| %>
            <tr>
              <td class="py-2 px-4 text-sm"><%= link_to liability.item_name, edit_user_liability_path(liability), class: "text-blue-600 hover:text-blue-800" %></td>
              <td class="py-2 px-4 text-sm text-right"><%= format_currency(liability.amount_cents, liability.amount_currency) %></td>
              <td class="py-2 px-4 text-sm text-right"><%= liability.interest_rate %>%</td>
              <td class="py-2 px-4 text-sm text-right"><%= format_currency(liability.minimum_monthly_payment_cents, liability.amount_currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="p-3 text-xs text-gray-500">Rates or minimums missing? Edit a debt to set them — the plan is only as good as its inputs.</p>
    </div>
  <% end %>
</div>
