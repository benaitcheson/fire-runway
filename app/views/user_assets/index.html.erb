<%= link_to 'New User Asset', new_user_asset_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mb-4 inline-block" %>

<table class="min-w-full bg-white border border-gray-200">
  <thead>
    <tr>
      <th class="py-2 px-4 border-b">Item Name</th>
      <th class="py-2 px-4 border-b">Purchase Price (Cents)</th>
      <th class="py-2 px-4 border-b">Purchase Price Currency</th>
      <th class="py-2 px-4 border-b">Purchase Date</th>
      <th class="py-2 px-4 border-b" colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @user_assets.each do |user_asset| %>
      <tr class="hover:bg-gray-100">
        <td class="py-2 px-4 border-b"><%= user_asset.item_name %></td>
        <td class="py-2 px-4 border-b"><%= user_asset.purchase_price_cents %></td>
        <td class="py-2 px-4 border-b"><%= user_asset.purchase_price_currency %></td>
        <td class="py-2 px-4 border-b"><%= user_asset.purchase_date %></td>
        <td class="py-2 px-4 border-b"><%= link_to 'Show', user_asset, class: "text-blue-500 hover:text-blue-700" %></td>
        <td class="py-2 px-4 border-b"><%= link_to 'Edit', edit_user_asset_path(user_asset), class: "text-yellow-500 hover:text-yellow-700" %></td>
        <td class="py-2 px-4 border-b"><%= link_to 'Destroy', user_asset, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:text-red-700" %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="1" class="py-2 px-4 border-t font-bold">Total</td>
      <td class="py-2 px-4 border-t"><%= @total_purchase_price_cents %></td>
      <td colspan="5" class="border-t"></td>
    </tr>
  </tfoot>
</table>