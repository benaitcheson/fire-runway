<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">My Assets</h1>
    <%= link_to 'Add New Asset', new_user_asset_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <% if @user_assets.any? %>
      <table class="min-w-full">
        <thead class="bg-gray-100">
          <tr>
            <th class="py-3 px-6 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Asset Name</th>
            <th class="py-3 px-6 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Purchase Price</th>
            <th class="py-3 px-6 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">Current Value</th>
            <th class="py-3 px-6 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">Purchase Date</th>
            <th class="py-3 px-6 text-center text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
          <% @user_assets.each do |asset| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="py-4 px-6 text-sm font-medium text-gray-900">
                <%= link_to asset.item_name, user_asset_path(asset), class: "text-blue-600 hover:text-blue-800" %>
              </td>
              <td class="py-4 px-6 text-sm text-right text-gray-700">
                <%= format_currency(asset.purchase_price_cents, asset.purchase_price_currency) %>
              </td>
              <td class="py-4 px-6 text-sm text-right">
                <span class="<%= asset.current_value_cents < asset.purchase_price_cents ? 'text-orange-600' : 'text-green-600' %>">
                  <%= format_currency(asset.current_value_cents, asset.purchase_price_currency) %>
                </span>
                <% if asset.depreciation_method != 'none' && asset.depreciation_percentage > 0 %>
                  <div class="text-xs text-gray-500">
                    <%= asset.depreciation_percentage %>% depreciated
                  </div>
                <% end %>
              </td>
              <td class="py-4 px-6 text-sm text-center text-gray-700">
                <%= format_date(asset.purchase_date) %>
              </td>
              <td class="py-4 px-6 text-sm text-center">
                <div class="flex justify-center space-x-2">
                  <%= link_to 'Edit', edit_user_asset_path(asset), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= link_to 'Delete', user_asset_path(asset), method: :delete, 
                      data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, 
                      class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>

        <tfoot class="bg-gray-100">
          <tr>
            <td class="py-4 px-6 text-sm font-bold text-gray-900">Total Assets</td>
            <td class="py-4 px-6 text-sm font-bold text-right text-gray-900">
              <%= format_currency(@total_purchase_price_cents, "AUD") %>
            </td>
            <td class="py-4 px-6 text-sm font-bold text-right text-gray-900">
              <%= format_currency(@total_current_value_cents, "AUD") %>
            </td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-gray-500 mb-4">You haven't added any assets yet.</p>
        <%= link_to 'Add Your First Asset', new_user_asset_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">Purchase Value</h3>
      <p class="text-2xl font-bold text-blue-600"><%= format_currency(@total_purchase_price_cents, "AUD") %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">Current Value</h3>
      <p class="text-2xl font-bold text-green-600"><%= format_currency(@total_current_value_cents, "AUD") %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">Total Depreciation</h3>
      <p class="text-2xl font-bold text-red-600">
        <%= format_currency(@total_purchase_price_cents - @total_current_value_cents, "AUD") %>
      </p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-700 mb-2">Number of Assets</h3>
      <p class="text-2xl font-bold text-purple-600"><%= @user_assets.count %></p>
    </div>
  </div>

  <% if @user_assets.any? { |asset| asset.depreciation_method != 'none' } %>
    <div class="mt-8 bg-white rounded-lg shadow p-6">
      <h3 class="text-xl font-semibold text-gray-700 mb-4">Asset Values Overview</h3>
      <%= column_chart @user_assets.select { |a| a.depreciation_method != 'none' }.map { |asset| 
            [asset.item_name, { 
              "Purchase Price" => asset.purchase_price_cents / 100.0,
              "Current Value" => asset.current_value_cents / 100.0
            }]
          }, 
          height: "300px",
          prefix: "$",
          thousands: ",",
          colors: ["#3b82f6", "#10b981"],
          stacked: false %>
    </div>
  <% end %>
</div>