<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6 flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold"><%= @user_asset.item_name %></h1>
      <p class="text-gray-600 mt-2">Asset Details</p>
    </div>
    <div class="flex space-x-2">
      <%= link_to "Edit", edit_user_asset_path(@user_asset), 
          class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      <%= link_to "Delete", user_asset_path(@user_asset), 
          method: :delete,
          data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this asset?" },
          class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="p-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Purchase Price</h3>
          <p class="text-2xl font-bold text-blue-600">
            <%= format_currency(@user_asset.purchase_price_cents, @user_asset.purchase_price_currency) %>
          </p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Current Value</h3>
          <p class="text-2xl font-bold <%= @user_asset.current_value_cents < @user_asset.purchase_price_cents ? 'text-orange-600' : 'text-green-600' %>">
            <%= format_currency(@user_asset.current_value_cents, @user_asset.purchase_price_currency) %>
          </p>
          <% if @user_asset.depreciation_method != 'none' %>
            <p class="text-xs text-gray-500 mt-1">
              <%= @user_asset.depreciation_percentage %>% depreciated
            </p>
          <% end %>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-2">Purchase Date</h3>
          <p class="text-xl font-semibold text-gray-900">
            <%= format_date(@user_asset.purchase_date) %>
          </p>
        </div>
      </div>

      <% if @user_asset.depreciation_method != 'none' %>
        <!-- Depreciation Chart -->
        <div class="border-t pt-6">
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Asset Value Over Time</h3>
          <div class="bg-white rounded-lg border p-4 mb-6">
            <%= line_chart @user_asset.depreciation_chart_data, 
                prefix: "$",
                thousands: ",",
                height: "300px",
                colors: ["#3b82f6"],
                curve: false,
                points: false,
                library: {
                  title: {
                    text: "#{@user_asset.item_name} - Value Depreciation",
                    style: {
                      fontSize: '16px',
                      fontWeight: 'bold'
                    }
                  },
                  xAxis: {
                    title: {
                      text: 'Time'
                    }
                  },
                  yAxis: {
                    title: {
                      text: 'Value ($)'
                    }
                  },
                  tooltip: {
                    format: '<b>{series.name}</b><br/>{point.x}: ${point.y:,.2f}'
                  },
                  plotOptions: {
                    line: {
                      zones: [{
                        value: Date.today.strftime("%b %Y"),
                        color: '#3b82f6'
                      }, {
                        color: '#94a3b8',
                        dashStyle: 'dot'
                      }]
                    }
                  }
                } %>
            <p class="text-xs text-gray-500 mt-2">
              Solid line shows historical depreciation, dotted line shows projected future values
            </p>
          </div>
        </div>

        <!-- Depreciation Details -->
        <div class="border-t pt-6">
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Depreciation Information</h3>
          <div class="bg-blue-50 rounded-lg p-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <dt class="text-sm text-gray-600">Method</dt>
                <dd class="text-sm font-medium text-gray-900">
                  <%= UserAsset::DEPRECIATION_METHODS[@user_asset.depreciation_method] %>
                </dd>
              </div>
              
              <% if @user_asset.useful_life_years.present? %>
                <div>
                  <dt class="text-sm text-gray-600">Useful Life</dt>
                  <dd class="text-sm font-medium text-gray-900">
                    <%= @user_asset.useful_life_years %> years
                  </dd>
                </div>
              <% end %>
              
              <% if @user_asset.depreciation_rate.present? %>
                <div>
                  <dt class="text-sm text-gray-600">Depreciation Rate</dt>
                  <dd class="text-sm font-medium text-gray-900">
                    <%= @user_asset.depreciation_rate %>% per year
                  </dd>
                </div>
              <% end %>
              
              <% if @user_asset.salvage_value_cents.present? && @user_asset.salvage_value_cents > 0 %>
                <div>
                  <dt class="text-sm text-gray-600">Salvage Value</dt>
                  <dd class="text-sm font-medium text-gray-900">
                    <%= format_currency(@user_asset.salvage_value_cents, @user_asset.purchase_price_currency) %>
                  </dd>
                </div>
              <% end %>
            </div>
            
            <div class="mt-4 pt-4 border-t border-blue-200">
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Total Depreciation</span>
                <span class="text-sm font-medium text-red-600">
                  <%= format_currency(@user_asset.purchase_price_cents - @user_asset.current_value_cents, @user_asset.purchase_price_currency) %>
                </span>
              </div>
              <% if @user_asset.depreciation_method == 'straight_line' && @user_asset.annual_depreciation_cents > 0 %>
                <div class="flex justify-between items-center mt-2">
                  <span class="text-sm text-gray-600">Annual Depreciation</span>
                  <span class="text-sm font-medium text-gray-900">
                    <%= format_currency(@user_asset.annual_depreciation_cents, @user_asset.purchase_price_currency) %>
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="border-t pt-6">
        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Additional Information</h3>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <dt class="text-sm text-gray-600">Currency</dt>
            <dd class="text-sm font-medium text-gray-900"><%= @user_asset.purchase_price_currency %></dd>
          </div>
          <div>
            <dt class="text-sm text-gray-600">Age of Asset</dt>
            <dd class="text-sm font-medium text-gray-900">
              <% if @user_asset.purchase_date %>
                <%= distance_of_time_in_words(@user_asset.purchase_date, Date.today) %>
              <% else %>
                Unknown
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-gray-600">Added to System</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= @user_asset.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-gray-600">Last Updated</dt>
            <dd class="text-sm font-medium text-gray-900">
              <%= @user_asset.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="bg-gray-50 px-6 py-4">
      <div class="flex justify-between items-center">
        <%= link_to "← Back to Assets", user_assets_path,
            class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <%= link_to "Add Another Asset", new_user_asset_path,
            class: "text-green-600 hover:text-green-800 font-medium" %>
      </div>
    </div>
  </div>

  <%= render "performance", asset: @user_asset if @user_asset.market_asset? %>
</div>